  /* =========================================================
     BAGIAN 5 — CATUR (mesin aturan lengkap)
     Mendukung: semua gerakan bidak, skak, skakmat, stalemate,
     castling/rokade (pendek & panjang), en passant, promosi pion.
  ========================================================= */
  var GLYPH = { wK:'♔',wQ:'♕',wR:'♖',wB:'♗',wN:'♘',wP:'♙', bK:'♚',bQ:'♛',bR:'♜',bB:'♝',bN:'♞',bP:'♟' };
  var KNIGHT_OFFS = [[1,2],[2,1],[-1,2],[-2,1],[1,-2],[2,-1],[-1,-2],[-2,-1]];
  var BISHOP_DIRS = [[1,1],[1,-1],[-1,1],[-1,-1]];
  var ROOK_DIRS = [[1,0],[-1,0],[0,1],[0,-1]];

  var chessState = null;
  var chessBoardSquares = null;
  var chessStatusEl = document.getElementById('chessStatus');

  function chessInBounds(r,c){ return r>=0 && r<8 && c>=0 && c<8; }
  function chessCloneBoard(b){ return b.map(function(row){ return row.slice(); }); }

  function chessInitialBoard(){
    var b = [];
    for(var r=0;r<8;r++) b.push(new Array(8).fill(null));
    var back = ['R','N','B','Q','K','B','N','R'];
    for(var c=0;c<8;c++){
      b[0][c] = 'w'+back[c];
      b[1][c] = 'wP';
      b[6][c] = 'bP';
      b[7][c] = 'b'+back[c];
    }
    return b;
  }

  function chessNewState(){
    return {
      board: chessInitialBoard(),
      turn: 'w',
      castling: {wK:true, wQ:true, bK:true, bQ:true},
      epTarget: null,
      capturedByWhite: [],
      capturedByBlack: [],
      selected: null,
      legalMovesForSelected: [],
      status: 'playing',
      pendingPromotion: null
    };
  }

  function chessFindKing(board, color){
    for(var r=0;r<8;r++) for(var c=0;c<8;c++){
      if(board[r][c]===color+'K') return {r:r,c:c};
    }
    return null;
  }

  function chessSquareAttacked(board, r, c, bySide){
    var dir = bySide==='w' ? 1 : -1;
    if(chessInBounds(r-dir,c-1) && board[r-dir][c-1]===bySide+'P') return true;
    if(chessInBounds(r-dir,c+1) && board[r-dir][c+1]===bySide+'P') return true;
    for(var i=0;i<KNIGHT_OFFS.length;i++){
      var nr=r+KNIGHT_OFFS[i][0], nc=c+KNIGHT_OFFS[i][1];
      if(chessInBounds(nr,nc) && board[nr][nc]===bySide+'N') return true;
    }
    for(var dr=-1;dr<=1;dr++) for(var dc=-1;dc<=1;dc++){
      if(dr===0 && dc===0) continue;
      var kr=r+dr, kc=c+dc;
      if(chessInBounds(kr,kc) && board[kr][kc]===bySide+'K') return true;
    }
    for(var bi=0;bi<BISHOP_DIRS.length;bi++){
      var d = BISHOP_DIRS[bi]; var sr=r+d[0], sc=c+d[1];
      while(chessInBounds(sr,sc)){
        var p = board[sr][sc];
        if(p){ if(p[0]===bySide && (p[1]==='B'||p[1]==='Q')) return true; break; }
        sr+=d[0]; sc+=d[1];
      }
    }
    for(var ri=0;ri<ROOK_DIRS.length;ri++){
      var rd = ROOK_DIRS[ri]; var sr2=r+rd[0], sc2=c+rd[1];
      while(chessInBounds(sr2,sc2)){
        var p2 = board[sr2][sc2];
        if(p2){ if(p2[0]===bySide && (p2[1]==='R'||p2[1]==='Q')) return true; break; }
        sr2+=rd[0]; sc2+=rd[1];
      }
    }
    return false;
  }

  function chessPawnMoves(state,r,c,color){
    var moves=[]; var dir = color==='w'?1:-1;
    var startRank = color==='w'?1:6;
    var promoRank = color==='w'?7:0;
    if(chessInBounds(r+dir,c) && !state.board[r+dir][c]){
      moves.push({from:{r:r,c:c}, to:{r:r+dir,c:c}, promotion:(r+dir===promoRank)});
      if(r===startRank && !state.board[r+2*dir][c]){
        moves.push({from:{r:r,c:c}, to:{r:r+2*dir,c:c}});
      }
    }
    [-1,1].forEach(function(dc){
      var nr=r+dir, nc=c+dc;
      if(!chessInBounds(nr,nc)) return;
      var target = state.board[nr][nc];
      if(target && target[0]!==color){
        moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}, capture:true, promotion:(nr===promoRank)});
      } else if(state.epTarget && state.epTarget.r===nr && state.epTarget.c===nc){
        moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}, capture:true, enPassant:true});
      }
    });
    return moves;
  }
  function chessKnightMoves(state,r,c,color){
    var moves=[];
    KNIGHT_OFFS.forEach(function(o){
      var nr=r+o[0], nc=c+o[1];
      if(!chessInBounds(nr,nc)) return;
      var t = state.board[nr][nc];
      if(!t) moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}});
      else if(t[0]!==color) moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}, capture:true});
    });
    return moves;
  }
  function chessSlideMoves(state,r,c,color,dirs){
    var moves=[];
    dirs.forEach(function(d){
      var nr=r+d[0], nc=c+d[1];
      while(chessInBounds(nr,nc)){
        var t = state.board[nr][nc];
        if(!t){ moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}}); }
        else { if(t[0]!==color) moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}, capture:true}); break; }
        nr+=d[0]; nc+=d[1];
      }
    });
    return moves;
  }
  function chessKingMoves(state,r,c,color){
    var moves=[];
    for(var dr=-1;dr<=1;dr++) for(var dc=-1;dc<=1;dc++){
      if(dr===0 && dc===0) continue;
      var nr=r+dr, nc=c+dc;
      if(!chessInBounds(nr,nc)) continue;
      var t = state.board[nr][nc];
      if(!t) moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}});
      else if(t[0]!==color) moves.push({from:{r:r,c:c}, to:{r:nr,c:nc}, capture:true});
    }
    var opp = color==='w'?'b':'w';
    var rank = color==='w'?0:7;
    if(r===rank && c===4 && !chessSquareAttacked(state.board, rank,4, opp)){
      if(state.castling[color+'K'] && !state.board[rank][5] && !state.board[rank][6] && state.board[rank][7]===color+'R'){
        if(!chessSquareAttacked(state.board, rank,5,opp) && !chessSquareAttacked(state.board, rank,6,opp)){
          moves.push({from:{r:rank,c:4}, to:{r:rank,c:6}, castle:'K'});
        }
      }
      if(state.castling[color+'Q'] && !state.board[rank][1] && !state.board[rank][2] && !state.board[rank][3] && state.board[rank][0]===color+'R'){
        if(!chessSquareAttacked(state.board, rank,3,opp) && !chessSquareAttacked(state.board, rank,2,opp)){
          moves.push({from:{r:rank,c:4}, to:{r:rank,c:2}, castle:'Q'});
        }
      }
    }
    return moves;
  }
  function chessPseudoMoves(state,r,c){
    var piece = state.board[r][c];
    if(!piece) return [];
    var color=piece[0], type=piece[1];
    if(type==='P') return chessPawnMoves(state,r,c,color);
    if(type==='N') return chessKnightMoves(state,r,c,color);
    if(type==='B') return chessSlideMoves(state,r,c,color,BISHOP_DIRS);
    if(type==='R') return chessSlideMoves(state,r,c,color,ROOK_DIRS);
    if(type==='Q') return chessSlideMoves(state,r,c,color,BISHOP_DIRS.concat(ROOK_DIRS));
    if(type==='K') return chessKingMoves(state,r,c,color);
    return [];
  }
  function chessApplyMoveSim(board, move, color){
    var piece = board[move.from.r][move.from.c];
    board[move.from.r][move.from.c] = null;
    if(move.enPassant){ board[move.from.r][move.to.c] = null; }
    board[move.to.r][move.to.c] = move.promotion ? (color+'Q') : piece;
    if(move.castle==='K'){ var rk=move.from.r; board[rk][5]=board[rk][7]; board[rk][7]=null; }
    else if(move.castle==='Q'){ var rk2=move.from.r; board[rk2][3]=board[rk2][0]; board[rk2][0]=null; }
    return board;
  }
  function chessGenerateLegalMoves(state, color){
    var all=[];
    for(var r=0;r<8;r++) for(var c=0;c<8;c++){
      var piece = state.board[r][c];
      if(!piece || piece[0]!==color) continue;
      var pseudo = chessPseudoMoves(state,r,c);
      pseudo.forEach(function(m){
        var sim = chessCloneBoard(state.board);
        chessApplyMoveSim(sim, m, color);
        var kp = chessFindKing(sim, color);
        if(kp && !chessSquareAttacked(sim, kp.r, kp.c, color==='w'?'b':'w')){
          all.push(m);
        }
      });
    }
    return all;
  }
  function chessMakeMove(state, move, promoChoice){
    var piece = state.board[move.from.r][move.from.c];
    var color = piece[0];
    var capturedPiece = state.board[move.to.r][move.to.c];
    if(move.enPassant){
      capturedPiece = state.board[move.from.r][move.to.c];
      state.board[move.from.r][move.to.c] = null;
    }
    if(capturedPiece){
      if(color==='w') state.capturedByWhite.push(capturedPiece); else state.capturedByBlack.push(capturedPiece);
    }
    state.board[move.from.r][move.from.c] = null;
    state.board[move.to.r][move.to.c] = move.promotion ? (color+(promoChoice||'Q')) : piece;
    if(move.castle==='K'){ var rk=move.from.r; state.board[rk][5]=state.board[rk][7]; state.board[rk][7]=null; }
    else if(move.castle==='Q'){ var rk2=move.from.r; state.board[rk2][3]=state.board[rk2][0]; state.board[rk2][0]=null; }

    if(piece[1]==='K'){ state.castling[color+'K']=false; state.castling[color+'Q']=false; }
    if(piece[1]==='R'){
      var homeRank = color==='w'?0:7;
      if(move.from.r===homeRank && move.from.c===0) state.castling[color+'Q']=false;
      if(move.from.r===homeRank && move.from.c===7) state.castling[color+'K']=false;
    }
    if(capturedPiece && capturedPiece[1]==='R'){
      var oppColor = color==='w'?'b':'w';
      var oppRank = oppColor==='w'?0:7;
      if(move.to.r===oppRank && move.to.c===0) state.castling[oppColor+'Q']=false;
      if(move.to.r===oppRank && move.to.c===7) state.castling[oppColor+'K']=false;
    }
    state.epTarget = null;
    if(piece[1]==='P' && Math.abs(move.to.r-move.from.r)===2){
      state.epTarget = {r:(move.from.r+move.to.r)/2, c:move.from.c};
    }
    state.turn = color==='w'?'b':'w';

    var legal = chessGenerateLegalMoves(state, state.turn);
    var kp = chessFindKing(state.board, state.turn);
    var inCheck = kp ? chessSquareAttacked(state.board, kp.r, kp.c, state.turn==='w'?'b':'w') : false;
    if(legal.length===0) state.status = inCheck ? 'checkmate' : 'stalemate';
    else state.status = inCheck ? 'check' : 'playing';
  }

  function chessPieceGlyph(p){ return p ? (GLYPH[p]||'') : ''; }

  function chessStatusText(){
    var turnLabel = chessState.turn==='w' ? 'Putih' : 'Hitam';
    if(chessState.status==='checkmate'){
      var winner = chessState.turn==='w' ? 'Hitam' : 'Putih';
      return 'Skakmat! ' + winner + ' menang';
    }
    if(chessState.status==='stalemate') return 'Seri (Stalemate)';
    if(chessState.status==='check') return 'Skak! Giliran: ' + turnLabel;
    return 'Giliran: ' + turnLabel;
  }

  function chessRenderBoard(){
    var checkPos = null;
    if(chessState.status==='check' || chessState.status==='checkmate'){
      checkPos = chessFindKing(chessState.board, chessState.turn);
    }
    chessBoardSquares.forEach(function(sq){
      var r = parseInt(sq.dataset.r,10), c = parseInt(sq.dataset.c,10);
      var piece = chessState.board[r][c];
      sq.innerHTML = '';
      sq.classList.remove('selected','check','white-piece','black-piece');
      if(piece){
        var span = document.createElement('span');
        span.textContent = chessPieceGlyph(piece);
        sq.appendChild(span);
        sq.classList.add(piece[0]==='w' ? 'white-piece' : 'black-piece');
      }
      if(chessState.selected && chessState.selected.r===r && chessState.selected.c===c) sq.classList.add('selected');
      if(checkPos && checkPos.r===r && checkPos.c===c) sq.classList.add('check');
      var moveHere = chessState.legalMovesForSelected.filter(function(m){ return m.to.r===r && m.to.c===c; })[0];
      if(moveHere){
        var marker = document.createElement('div');
        marker.className = piece ? 'ring' : 'dot';
        sq.appendChild(marker);
      }
    });
    chessStatusEl.textContent = chessStatusText();
    document.getElementById('chessCapturedTop').textContent = chessState.capturedByWhite.map(chessPieceGlyph).join(' ') || '\u00A0';
    document.getElementById('chessCapturedBottom').textContent = chessState.capturedByBlack.map(chessPieceGlyph).join(' ') || '\u00A0';
  }

  function chessSelectSquare(r,c){
    if(chessState.pendingPromotion) return;
    if(chessState.status==='checkmate' || chessState.status==='stalemate') return;
    var piece = chessState.board[r][c];
    if(chessState.selected){
      var move = chessState.legalMovesForSelected.filter(function(m){ return m.to.r===r && m.to.c===c; })[0];
      if(move){
        if(move.promotion){
          chessState.pendingPromotion = move;
          document.getElementById('promoOverlay').classList.add('show');
          return;
        }
        chessMakeMove(chessState, move);
        chessState.selected=null; chessState.legalMovesForSelected=[];
        chessRenderBoard();
        return;
      }
    }
    if(piece && piece[0]===chessState.turn){
      chessState.selected = {r:r,c:c};
      var legalAll = chessGenerateLegalMoves(chessState, chessState.turn);
      chessState.legalMovesForSelected = legalAll.filter(function(m){ return m.from.r===r && m.from.c===c; });
    } else {
      chessState.selected = null; chessState.legalMovesForSelected = [];
    }
    chessRenderBoard();
  }

  function initChess(){
    chessState = chessNewState();
    chessBoardSquares = Array.prototype.slice.call(document.querySelectorAll('.chess-sq'));
    document.getElementById('chessReset').addEventListener('click', function(){
      chessState = chessNewState();
      chessRenderBoard();
    });
    document.querySelectorAll('.promo-btn').forEach(function(btn){
      btn.addEventListener('click', function(){
        var move = chessState.pendingPromotion;
        if(!move) return;
        chessMakeMove(chessState, move, btn.dataset.piece);
        chessState.pendingPromotion = null;
        chessState.selected=null; chessState.legalMovesForSelected=[];
        document.getElementById('promoOverlay').classList.remove('show');
        chessRenderBoard();
      });
    });
    chessRenderBoard();
    return true;
  }

  /* =========================================================
     BAGIAN 6 — CACING (SNAKE / "CACING MUKBANG")
  ========================================================= */
  var SNAKE_COLS = 15, SNAKE_CELL = 20, SNAKE_TICK = 210;
  var snakeCanvas = document.getElementById('snakeCanvas');
  var snakeCtx = snakeCanvas ? snakeCanvas.getContext('2d') : null;
  var snakeState = null;

  function snakeInitState(){
    var mid = Math.floor(SNAKE_COLS/2);
    return {
      body: [{x:mid,y:mid},{x:mid-1,y:mid},{x:mid-2,y:mid}],
      dir: {x:1,y:0},
      nextDir: {x:1,y:0},
      food: null,
      score: 0,
      timer: null,
      over: false,
      running: false
    };
  }
  function snakeRandomFood(){
    var occupied = {};
    snakeState.body.forEach(function(s){ occupied[s.x+','+s.y] = true; });
    var free = [];
    for(var x=0;x<SNAKE_COLS;x++) for(var y=0;y<SNAKE_COLS;y++){
      if(!occupied[x+','+y]) free.push({x:x,y:y});
    }
    if(free.length===0) return {x:0,y:0};
    return free[Math.floor(Math.random()*free.length)];
  }
  function snakeDraw(){
    if(!snakeCtx) return;
    snakeCtx.clearRect(0,0,snakeCanvas.width, snakeCanvas.height);
    snakeCtx.fillStyle = '#05070a';
    snakeCtx.fillRect(0,0,snakeCanvas.width, snakeCanvas.height);
    // grid subtle
    snakeCtx.strokeStyle = 'rgba(255,255,255,0.03)';
    for(var g=0; g<=SNAKE_COLS; g++){
      snakeCtx.beginPath(); snakeCtx.moveTo(g*SNAKE_CELL,0); snakeCtx.lineTo(g*SNAKE_CELL, SNAKE_COLS*SNAKE_CELL); snakeCtx.stroke();
      snakeCtx.beginPath(); snakeCtx.moveTo(0,g*SNAKE_CELL); snakeCtx.lineTo(SNAKE_COLS*SNAKE_CELL, g*SNAKE_CELL); snakeCtx.stroke();
    }
    // food
    if(snakeState.food){
      snakeCtx.fillStyle = '#6fa8ff';
      snakeCtx.shadowColor = 'rgba(47,125,255,0.9)';
      snakeCtx.shadowBlur = 12;
      var fx = snakeState.food.x*SNAKE_CELL + SNAKE_CELL/2, fy = snakeState.food.y*SNAKE_CELL + SNAKE_CELL/2;
      snakeCtx.beginPath(); snakeCtx.arc(fx, fy, SNAKE_CELL*0.32, 0, Math.PI*2); snakeCtx.fill();
      snakeCtx.shadowBlur = 0;
    }
    // snake
    snakeState.body.forEach(function(seg, i){
      var isHead = i===0;
      snakeCtx.fillStyle = isHead ? '#eaf0fb' : '#2f7dff';
      var pad = 2;
      snakeCtx.beginPath();
      var rx = seg.x*SNAKE_CELL+pad, ry = seg.y*SNAKE_CELL+pad, rw = SNAKE_CELL-pad*2, rh = SNAKE_CELL-pad*2;
      var rr = 6;
      snakeCtx.moveTo(rx+rr,ry);
      snakeCtx.arcTo(rx+rw,ry,rx+rw,ry+rh,rr);
      snakeCtx.arcTo(rx+rw,ry+rh,rx,ry+rh,rr);
      snakeCtx.arcTo(rx,ry+rh,rx,ry,rr);
      snakeCtx.arcTo(rx,ry,rx+rw,ry,rr);
      snakeCtx.closePath();
      snakeCtx.fill();
    });
    document.getElementById('snakeScoreVal').textContent = snakeState.score;
  }
  function snakeTick(){
    var dir = snakeState.nextDir;
    snakeState.dir = dir;
    var head = snakeState.body[0];
    var newHead = {x:head.x+dir.x, y:head.y+dir.y};
    if(newHead.x<0 || newHead.x>=SNAKE_COLS || newHead.y<0 || newHead.y>=SNAKE_COLS){ return snakeGameOver(); }
    for(var i=0;i<snakeState.body.length;i++){
      if(snakeState.body[i].x===newHead.x && snakeState.body[i].y===newHead.y) return snakeGameOver();
    }
    snakeState.body.unshift(newHead);
    if(snakeState.food && newHead.x===snakeState.food.x && newHead.y===snakeState.food.y){
      snakeState.score++;
      snakeState.food = snakeRandomFood();
    } else {
      snakeState.body.pop();
    }
    snakeDraw();
  }
  function snakeSetDir(dir){
    var map = {up:{x:0,y:-1}, down:{x:0,y:1}, left:{x:-1,y:0}, right:{x:1,y:0}};
    var d = map[dir];
    if(!d) return;
    // cegah membalik langsung ke arah berlawanan
    if(d.x === -snakeState.dir.x && d.y === -snakeState.dir.y) return;
    snakeState.nextDir = d;
  }
  function snakeGameOver(){
    snakeState.over = true;
    snakeStop();
    var ov = document.getElementById('snakeOverlay');
    document.getElementById('snakeOverlayTitle').textContent = 'Game Over';
    document.getElementById('snakeOverlaySub').textContent = 'Skor akhir: ' + snakeState.score;
    document.getElementById('snakeStartBtn').textContent = 'Main Lagi';
    ov.classList.remove('hide');
  }
  function snakeStop(){
    if(snakeState && snakeState.timer){ clearInterval(snakeState.timer); snakeState.timer=null; }
    if(snakeState) snakeState.running = false;
  }
  function snakeStart(){
    snakeState = snakeInitState();
    snakeState.food = snakeRandomFood();
    snakeState.running = true;
    document.getElementById('snakeOverlay').classList.add('hide');
    snakeDraw();
    snakeState.timer = setInterval(snakeTick, SNAKE_TICK);
  }
  function initSnake(){
    document.getElementById('snakeStartBtn').addEventListener('click', snakeStart);
    document.querySelectorAll('.snake-dbtn').forEach(function(btn){
      btn.addEventListener('click', function(){ snakeSetDir(btn.dataset.dir); });
    });
    var touchStartX=0, touchStartY=0;
    snakeCanvas.addEventListener('touchstart', function(e){
      touchStartX = e.touches[0].clientX; touchStartY = e.touches[0].clientY;
    }, {passive:true});
    snakeCanvas.addEventListener('touchend', function(e){
      var dx = e.changedTouches[0].clientX - touchStartX;
      var dy = e.changedTouches[0].clientY - touchStartY;
      if(Math.abs(dx) < 20 && Math.abs(dy) < 20) return;
      if(Math.abs(dx) > Math.abs(dy)) snakeSetDir(dx>0?'right':'left');
      else snakeSetDir(dy>0?'down':'up');
    }, {passive:true});
    document.addEventListener('keydown', function(e){
      if(!screens.cacing.classList.contains('show')) return;
      if(e.key==='ArrowUp') snakeSetDir('up');
      else if(e.key==='ArrowDown') snakeSetDir('down');
      else if(e.key==='ArrowLeft') snakeSetDir('left');
      else if(e.key==='ArrowRight') snakeSetDir('right');
    });
    snakeState = snakeInitState();
    snakeDraw();
    return true;
  }

