  var DICT = VERB_DICT.concat(WORD_DICT).concat(EXTRA_WORD_DICT);
  var POS_LABEL = {verb:'Kata Kerja', noun:'Kata Benda', adjective:'Kata Sifat', adverb:'Kata Keterangan', other:'Kata Keterangan/Depan'};

  function kamusRenderList(filter){
    var listEl = document.getElementById('kamusList');
    if(!listEl) return;
    listEl.innerHTML='';
    var q = (filter||'').toLowerCase().trim();
    var filtered = DICT.filter(function(d){
      return !q || d.word.toLowerCase().indexOf(q)===0 || d.id.toLowerCase().indexOf(q)>=0;
    });
    document.getElementById('kamusCount').textContent = filtered.length + ' kata';
    if(filtered.length===0){
      listEl.innerHTML = '<div class="kamus-empty">Kata tidak ditemukan</div>';
      return;
    }
    filtered.forEach(function(d){
      var row = document.createElement('div');
      row.className='kamus-item';
      row.innerHTML =
        '<div><div class="kamus-word">'+d.word+(d.pos==='verb'?'<span class="kamus-tag">V1 V2 V3</span>':'')+'</div>' +
        '<div class="kamus-meaning">'+d.id+'</div></div><div class="menu-chevron">&#8250;</div>';
      row.addEventListener('click', function(){ kamusShowDetail(d); });
      listEl.appendChild(row);
    });
  }
  function kamusShowDetail(d){
    document.getElementById('kdWord').textContent = d.word;
    document.getElementById('kdPos').textContent = POS_LABEL[d.pos] || d.pos;
    document.getElementById('kdMeaning').textContent = d.id;
    var vEl = document.getElementById('kdVerbs');
    if(d.pos==='verb'){
      vEl.classList.add('show');
      document.getElementById('kdV1').textContent = d.v1;
      document.getElementById('kdV2').textContent = d.v2;
      document.getElementById('kdV3').textContent = d.v3;
      document.getElementById('kdPassive').textContent = 'Bentuk pasif memakai V3: to be + "' + d.v3 + '" (contoh: is/are ' + d.v3 + ', was/were ' + d.v3 + ').';
    } else {
      vEl.classList.remove('show');
    }
    document.getElementById('kdOverlay').classList.add('show');
  }
  function initKamus(){
    document.getElementById('kamusSearch').addEventListener('input', function(e){ kamusRenderList(e.target.value); });
    document.getElementById('kdClose').addEventListener('click', function(){ document.getElementById('kdOverlay').classList.remove('show'); });
    kamusRenderList('');
    return true;
  }

  /* =========================================================
     BAGIAN 8 — KUIS BAHASA INGGRIS (soal acak A/B/C/D, generatif, tanpa batas)
  ========================================================= */
  var kuisState = { score:0, total:0, streak:0, current:null };

  function kuisShuffle(arr){
    var a = arr.slice();
    for(var i=a.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=a[i]; a[i]=a[j]; a[j]=t; }
    return a;
  }
  function kuisBuildOptions(correct, pool){
    var wrongPool = kuisShuffle(pool.filter(function(v){ return v!==correct; }));
    var wrongs = []; var seen = {};
    for(var k=0;k<wrongPool.length && wrongs.length<3;k++){
      if(!seen[wrongPool[k]]){ seen[wrongPool[k]]=true; wrongs.push(wrongPool[k]); }
    }
    return kuisShuffle(wrongs.concat([correct]));
  }
  function kuisNewQuestion(){
    var verbEntries = DICT.filter(function(d){ return d.pos==='verb'; });
    var qType = ['meaning','reverse','v2','v3'][Math.floor(Math.random()*4)];
    var pick, correct, options, promptText;
    if(qType==='meaning'){
      pick = DICT[Math.floor(Math.random()*DICT.length)];
      correct = pick.id;
      promptText = 'Apa arti kata "' + pick.word + '" dalam Bahasa Indonesia?';
      options = kuisBuildOptions(correct, DICT.map(function(d){ return d.id; }));
    } else if(qType==='reverse'){
      pick = DICT[Math.floor(Math.random()*DICT.length)];
      correct = pick.word;
      promptText = 'Kata Bahasa Inggris apa yang berarti "' + pick.id + '"?';
      options = kuisBuildOptions(correct, DICT.map(function(d){ return d.word; }));
    } else if(qType==='v2'){
      pick = verbEntries[Math.floor(Math.random()*verbEntries.length)];
      correct = pick.v2;
      promptText = 'Apa bentuk Past Tense (V2) dari kata kerja "' + pick.word + '"?';
      options = kuisBuildOptions(correct, verbEntries.map(function(d){ return d.v2; }));
    } else {
      pick = verbEntries[Math.floor(Math.random()*verbEntries.length)];
      correct = pick.v3;
      promptText = 'Apa bentuk Past Participle (V3) dari kata kerja "' + pick.word + '"?';
      options = kuisBuildOptions(correct, verbEntries.map(function(d){ return d.v3; }));
    }
    kuisState.current = {correct:correct};
    kuisRenderQuestion(promptText, options);
  }
  function kuisRenderQuestion(promptText, options){
    document.getElementById('kuisPrompt').textContent = promptText;
    var wrap = document.getElementById('kuisOptions');
    wrap.innerHTML = '';
    var labels = ['A','B','C','D'];
    options.forEach(function(opt, i){
      var btn = document.createElement('button');
      btn.className = 'kuis-opt';
      btn.dataset.val = opt;
      btn.innerHTML = '<span class="kuis-opt-label">'+labels[i]+'</span><span>'+opt+'</span>';
      btn.addEventListener('click', function(){ kuisAnswer(opt, btn); });
      wrap.appendChild(btn);
    });
    document.getElementById('kuisNextBtn').classList.remove('show');
  }
  function kuisAnswer(selected, btnEl){
    var correct = kuisState.current.correct;
    document.querySelectorAll('.kuis-opt').forEach(function(b){
      b.style.pointerEvents='none';
      if(b.dataset.val===correct) b.classList.add('correct');
    });
    if(selected===correct){ btnEl.classList.add('correct'); kuisState.score++; kuisState.streak++; }
    else { btnEl.classList.add('wrong'); kuisState.streak=0; }
    kuisState.total++;
    document.getElementById('kuisScoreVal').textContent = kuisState.score;
    document.getElementById('kuisTotalVal').textContent = kuisState.total;
    document.getElementById('kuisStreakVal').textContent = kuisState.streak;
    document.getElementById('kuisNextBtn').classList.add('show');
  }
  function initQuiz(){
    document.getElementById('kuisNextBtn').addEventListener('click', kuisNewQuestion);
    kuisNewQuestion();
    return true;
  }

  /* =========================================================
     BAGIAN 9 — UNO FLIP (2 sisi kartu: Terang & Gelap), 2-5 pemain lokal
  ========================================================= */
  var LIGHT_COLORS = ['red','yellow','green','blue'];
  var DARK_COLORS = ['pink','orange','teal','purple'];
  var COLOR_LABEL = {
    red:'Merah', yellow:'Kuning', green:'Hijau', blue:'Biru',
    pink:'Merah Muda', orange:'Oranye', teal:'Toska', purple:'Ungu'
  };
  var unoState = null;
  var unoSelectedPlayers = 2;

  function unoBuildLightFaces(color){
    var arr = [{color:color,type:'number',value:0}];
    for(var n=1;n<=9;n++){ arr.push({color:color,type:'number',value:n}); arr.push({color:color,type:'number',value:n}); }
    for(var s=0;s<2;s++) arr.push({color:color,type:'skip'});
    for(var s2=0;s2<2;s2++) arr.push({color:color,type:'reverse'});
    for(var s3=0;s3<2;s3++) arr.push({color:color,type:'draw1'});
    return arr;
  }
  function unoBuildDarkFaces(color){
    var arr = [{color:color,type:'number',value:1},{color:color,type:'number',value:1},{color:color,type:'number',value:1}];
    for(var n=2;n<=9;n++){ arr.push({color:color,type:'number',value:n}); arr.push({color:color,type:'number',value:n}); }
    for(var s=0;s<2;s++) arr.push({color:color,type:'skipAll'});
    for(var s2=0;s2<2;s2++) arr.push({color:color,type:'reverse'});
    for(var s3=0;s3<2;s3++) arr.push({color:color,type:'draw5'});
    return arr;
  }
  function unoBuildDeck(){
    var deck=[], id=0;
    for(var ci=0; ci<4; ci++){
      var lc=LIGHT_COLORS[ci], dc=DARK_COLORS[ci];
      var lf=unoBuildLightFaces(lc), df=unoBuildDarkFaces(dc);
      for(var i=0;i<lf.length;i++) deck.push({id:id++, light:lf[i], dark:df[i]});
      deck.push({id:id++, light:{color:lc,type:'flip'}, dark:{color:dc,type:'flip'}});
    }
    for(var w=0;w<4;w++) deck.push({id:id++, light:{color:null,type:'wild'}, dark:{color:null,type:'wild'}});
    for(var w2=0;w2<4;w2++) deck.push({id:id++, light:{color:null,type:'wildDraw2'}, dark:{color:null,type:'wildDrawColor'}});
    return deck;
  }
  function unoShuffle(arr){
    for(var i=arr.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var t=arr[i]; arr[i]=arr[j]; arr[j]=t; }
    return arr;
  }
  function unoCardFace(card){ return card[unoState.side]; }
  function unoTopCard(){ return unoState.discard[unoState.discard.length-1]; }
  function unoDrawFromDeck(){
    if(unoState.deck.length===0){
      var top = unoState.discard.pop();
      unoState.deck = unoShuffle(unoState.discard);
      unoState.discard = [top];
    }
    return unoState.deck.pop();
  }
  function unoPeekNextIndex(){
    return ((unoState.currentIndex + unoState.direction) % unoState.numPlayers + unoState.numPlayers) % unoState.numPlayers;
  }
  function unoCanPlay(card){
    var face = unoCardFace(card);
    var topFace = unoCardFace(unoTopCard());
    if(face.type==='wild' || face.type==='wildDraw2' || face.type==='wildDrawColor') return true;
    if(face.color === unoState.currentColor) return true;
    if(face.type==='number' && topFace.type==='number' && face.value===topFace.value) return true;
    if(face.type!=='number' && face.type===topFace.type) return true;
    return false;
  }
  function unoColorClass(color){ return color ? ('c-'+color) : 'c-wild'; }
  function unoColorLabel(color){ return color ? (COLOR_LABEL[color]||color) : '-'; }
  function unoFaceSymbol(face){
    if(face.type==='number') return String(face.value);
    if(face.type==='skip') return '⦸';
    if(face.type==='skipAll') return '⦸⦸';
    if(face.type==='reverse') return '⇄';
    if(face.type==='draw1') return '+1';
    if(face.type==='draw5') return '+5';
    if(face.type==='flip') return '⟲';
    if(face.type==='wild') return '★';
    if(face.type==='wildDraw2') return '+2★';
    if(face.type==='wildDrawColor') return '★?';
    return '?';
  }

  function unoStartGame(n){
    unoState = { deck:unoShuffle(unoBuildDeck()), discard:[], players:[], numPlayers:n,
      currentIndex:0, direction:1, side:'light', currentColor:null, status:'playing', winner:null, pendingWild:null };
    for(var p=0;p<n;p++) unoState.players.push([]);
    for(var r=0;r<7;r++) for(var p2=0;p2<n;p2++) unoState.players[p2].push(unoDrawFromDeck());
    var starter;
    do { starter = unoDrawFromDeck(); } while(starter.light.type!=='number');
    unoState.discard.push(starter);
    unoState.currentColor = starter.light.color;
    document.getElementById('unoWinnerOverlay').classList.remove('show');
    unoRenderAll();
    unoShowPassGate();
  }
  function unoResolveEffectAndAdvance(face){
    var skipCount=0, drawNext=0, reverseFlag=false, flipFlag=false;
    if(face.type==='skip'){ skipCount=1; }
    else if(face.type==='skipAll'){ skipCount = unoState.numPlayers-1; }
    else if(face.type==='reverse'){ reverseFlag=true; }
    else if(face.type==='draw1'){ drawNext=1; skipCount=1; }
    else if(face.type==='draw5'){ drawNext=5; skipCount=1; }
    else if(face.type==='wildDraw2'){ drawNext=2; skipCount=1; }
    else if(face.type==='flip'){ flipFlag=true; }

    if(reverseFlag){
      unoState.direction *= -1;
      if(unoState.numPlayers===2) skipCount=1;
    }
    if(flipFlag){
      unoState.side = unoState.side==='light' ? 'dark' : 'light';
      unoState.currentColor = unoCardFace(unoTopCard()).color;
    }
    if(face.type==='wildDrawColor'){
      var nextIdx = unoPeekNextIndex();
      var drawn=0;
      while(drawn<8){
        var c = unoDrawFromDeck();
        unoState.players[nextIdx].push(c);
        drawn++;
        if(unoCardFace(c).color===unoState.currentColor) break;
      }
      skipCount=1;
    } else if(drawNext>0){
      var nextIdx2 = unoPeekNextIndex();
      for(var d=0; d<drawNext; d++) unoState.players[nextIdx2].push(unoDrawFromDeck());
    }
    for(var s=0; s<=skipCount; s++){
      unoState.currentIndex = ((unoState.currentIndex + unoState.direction) % unoState.numPlayers + unoState.numPlayers) % unoState.numPlayers;
    }
  }
  function unoPlayCard(playerIdx, cardIdx){
    var hand = unoState.players[playerIdx];
    var card = hand[cardIdx];
    if(!unoCanPlay(card)) return false;
    hand.splice(cardIdx,1);
    unoState.discard.push(card);
    var face = unoCardFace(card);
    if(hand.length===0){
      unoState.status='finished'; unoState.winner=playerIdx;
      if(face.color) unoState.currentColor = face.color;
      unoRenderAll();
      return true;
    }
    if(face.type==='wild' || face.type==='wildDraw2' || face.type==='wildDrawColor'){
      unoState.pendingWild = {face:face, playerIdx:playerIdx};
      unoShowColorPicker();
      return true;
    }
    unoState.currentColor = face.color;
    unoResolveEffectAndAdvance(face);
    unoRenderAll();
    unoShowPassGate();
    return true;
  }
  function unoShowColorPicker(){
    var opts = document.getElementById('unoColorOptions');
    opts.innerHTML='';
    var colors = unoState.side==='light' ? LIGHT_COLORS : DARK_COLORS;
    colors.forEach(function(c){
      var b = document.createElement('button');
      b.className = 'uno-color-btn ' + unoColorClass(c);
      b.textContent = COLOR_LABEL[c] || c;
      b.addEventListener('click', function(){
        document.getElementById('unoColorOverlay').classList.remove('show');
        unoChooseColor(c);
      });
      opts.appendChild(b);
    });
    document.getElementById('unoColorOverlay').classList.add('show');
  }
  function unoChooseColor(color){
    unoState.currentColor = color;
    var pending = unoState.pendingWild;
    unoState.pendingWild = null;
    unoResolveEffectAndAdvance(pending.face);
    unoRenderAll();
    unoShowPassGate();
  }
  function unoRenderCardEl(el, face){
    el.className = 'uno-card ' + unoColorClass(face.color);
    el.textContent = unoFaceSymbol(face);
  }
  function unoRenderAll(){
    if(unoState.status==='finished'){
      document.getElementById('unoWinnerNum').textContent = (unoState.winner+1);
      document.getElementById('unoWinnerOverlay').classList.add('show');
      return;
    }
    var top = unoTopCard();
    unoRenderCardEl(document.getElementById('unoTopCard'), unoCardFace(top));
    document.getElementById('unoCurrentColorLabel').textContent = unoColorLabel(unoState.currentColor);
    document.getElementById('unoSideLabel').textContent = unoState.side==='light' ? 'SISI TERANG' : 'SISI GELAP';
    var oppEl = document.getElementById('unoOpponents');
    oppEl.innerHTML='';
    for(var i=0;i<unoState.numPlayers;i++){
      if(i===unoState.currentIndex) continue;
      var chip = document.createElement('div');
      chip.className='uno-opp-chip';
      chip.textContent = 'P'+(i+1)+': '+unoState.players[i].length+' kartu';
      oppEl.appendChild(chip);
    }
    document.getElementById('unoTurnLabel').textContent = 'Giliran: Pemain ' + (unoState.currentIndex+1);
  }
  function unoRevealHand(){
    var handEl = document.getElementById('unoHand');
    handEl.innerHTML='';
    var hand = unoState.players[unoState.currentIndex];
    hand.forEach(function(card, idx){
      var face = unoCardFace(card);
      var el = document.createElement('div');
      var can = unoCanPlay(card);
      el.className = 'uno-card ' + unoColorClass(face.color) + (can?' playable':' disabled');
      el.textContent = unoFaceSymbol(face);
      el.addEventListener('click', function(){ if(can) unoPlayCard(unoState.currentIndex, idx); });
      handEl.appendChild(el);
    });
  }
  function unoShowPassGate(){
    document.getElementById('unoPassGate').classList.add('show');
    document.getElementById('unoBoard').classList.remove('show');
    document.getElementById('unoPassLabel').textContent = (unoState.currentIndex+1);
  }
  function initUno(){
    var selectWrap = document.getElementById('unoPlayerSelect');
    [2,3,4,5].forEach(function(n){
      var b = document.createElement('button');
      b.className = 'uno-pbtn' + (n===unoSelectedPlayers?' active':'');
      b.textContent = n;
      b.addEventListener('click', function(){
        unoSelectedPlayers = n;
        selectWrap.querySelectorAll('.uno-pbtn').forEach(function(x){ x.classList.remove('active'); });
        b.classList.add('active');
      });
      selectWrap.appendChild(b);
    });
    document.getElementById('unoStartBtn').addEventListener('click', function(){
      showScreen('uno');
      unoStartGame(unoSelectedPlayers);
    });
    document.getElementById('unoPassBtn').addEventListener('click', function(){
      document.getElementById('unoPassGate').classList.remove('show');
      document.getElementById('unoBoard').classList.add('show');
      unoRevealHand();
    });
    document.getElementById('unoDrawBtn').addEventListener('click', function(){
      if(!unoState || unoState.status!=='playing') return;
      unoState.players[unoState.currentIndex].push(unoDrawFromDeck());
      unoRevealHand();
    });
    document.getElementById('unoPassTurnBtn').addEventListener('click', function(){
      if(!unoState || unoState.status!=='playing') return;
      unoState.currentIndex = unoPeekNextIndex();
      unoRenderAll();
      unoShowPassGate();
    });
    document.getElementById('unoPlayAgainBtn').addEventListener('click', function(){
      document.getElementById('unoWinnerOverlay').classList.remove('show');
      showScreen('uno-setup');
    });
    return true;
  }

  /* =========================================================
     KEYBOARD FISIK (opsional, untuk kalkulator saat di browser)
  ========================================================= */
  function bindKeyboard(){
    document.addEventListener('keydown', function(e){
      if(!screens.calculator.classList.contains('show')) return;
      var k = e.key;
      if(k>='0' && k<='9') inputNum(k);
      else if(k==='.') inputDot();
      else if(k==='+') inputOp('+');
      else if(k==='-') inputOp('-');
      else if(k==='*') inputOp('×');
      else if(k==='/'){ e.preventDefault(); inputOp('÷'); }
      else if(k==='%') inputPercent();
      else if(k==='Backspace') backspace();
      else if(k==='Escape') clearAll();
      else if(k==='Enter' || k==='=') doEquals();
    });
    return true;
  }

  /* =========================================================
     MULAI PROSES LOADING NYATA (berurutan, tiap tahap kerja nyata)
  ========================================================= */
  setProgress();
  nextFrame()
    .then(function(){ return buildListSequential(document.getElementById('homeList'), homeItems, 0); })
    .then(function(){ return buildKeysSequential(0); })
    .then(function(){ return buildTttSequential(0); })
    .then(function(){ tttCells = Array.prototype.slice.call(document.querySelectorAll('.ttt-cell')); })
    .then(function(){ return buildChessSequential(0); })
    .then(function(){ runSystemSteps(0); });

})();
