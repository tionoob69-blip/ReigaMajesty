<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
<title>Aplikasi Ku</title>
<style>
  :root{
    --bg:#000000;
    --panel:#0b0f16;
    --panel-2:#11161f;
    --line:#1c2331;
    --blue:#2f7dff;
    --blue-light:#6fa8ff;
    --blue-glow:rgba(47,125,255,0.55);
    --text:#eaf0fb;
    --text-dim:#7c8aa3;
    --danger:#ff5d6c;
    --green:#3ddc84;
  }
  *{box-sizing:border-box; -webkit-tap-highlight-color:transparent; user-select:none;}
  html,body{
    margin:0; padding:0; height:100%; width:100%;
    background:var(--bg);
    font-family: -apple-system, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
    overflow:hidden;
    color:var(--text);
  }
  #app{ position:fixed; inset:0; background:var(--bg); }

  /* ================= LOADING SCREEN ================= */
  #loading{
    position:fixed; inset:0; background:var(--bg);
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    z-index:999; transition:opacity .5s ease, transform .5s ease;
  }
  #loading.hide{ opacity:0; transform:scale(1.03); pointer-events:none; }
  .brand-wrap{ display:flex; flex-direction:column; align-items:center; margin-bottom:46px; }
  .logo-ring{ position:relative; width:120px; height:120px; display:flex; align-items:center; justify-content:center; margin-bottom:22px; }
  .logo-ring svg{ position:absolute; top:0; left:0; transform:rotate(-90deg); }
  .logo-track{ fill:none; stroke:#131826; stroke-width:5; }
  .logo-progress{
    fill:none; stroke:url(#blueGrad); stroke-width:5; stroke-linecap:round;
    stroke-dasharray:339.292; stroke-dashoffset:339.292;
    filter:drop-shadow(0 0 6px var(--blue-glow));
    transition:stroke-dashoffset .18s ease-out;
  }
  .logo-mark{
    width:64px; height:64px; border-radius:18px;
    background:linear-gradient(155deg,#1a2130,#0a0d13);
    border:1px solid var(--line);
    display:flex; align-items:center; justify-content:center;
    box-shadow:0 0 22px var(--blue-glow), inset 0 0 12px rgba(47,125,255,0.12);
  }
  .logo-mark svg{ width:32px; height:32px; }
  .logo-emoji{ font-size:34px; line-height:1; filter:drop-shadow(0 0 8px rgba(111,168,255,0.6)); }
  .brand-name{ font-size:19px; font-weight:700; letter-spacing:2px; color:var(--text); text-transform:uppercase; }
  .brand-sub{ font-size:11px; letter-spacing:3px; color:var(--text-dim); margin-top:6px; text-transform:uppercase; }
  .percent{
    font-size:44px; font-weight:800; letter-spacing:1px; color:var(--blue-light);
    font-variant-numeric:tabular-nums; text-shadow:0 0 18px var(--blue-glow); margin-bottom:8px;
  }
  .bar-outer{ width:220px; height:5px; border-radius:4px; background:#12151d; overflow:hidden; margin-top:4px; border:1px solid var(--line); }
  .bar-inner{
    height:100%; width:0%;
    background:linear-gradient(90deg, #1e5fd6, var(--blue), var(--blue-light));
    box-shadow:0 0 10px var(--blue-glow); transition:width .18s ease-out;
  }
  .status-text{ margin-top:16px; font-size:12px; color:var(--text-dim); letter-spacing:.5px; height:16px; text-align:center; }
  #continueBtn{
    margin-top:34px; padding:13px 38px; border-radius:30px;
    border:1px solid rgba(111,168,255,0.5);
    background:linear-gradient(180deg, rgba(47,125,255,0.18), rgba(47,125,255,0.05));
    color:var(--blue-light); font-size:14px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
    opacity:0; transform:translateY(10px) scale(.96); pointer-events:none;
    transition:opacity .45s ease, transform .45s ease, box-shadow .3s ease;
  }
  #continueBtn.show{ opacity:1; transform:translateY(0) scale(1); pointer-events:auto; animation:pulseGlow 2s ease-in-out infinite; }
  #continueBtn:active{ transform:scale(.94); }
  @keyframes pulseGlow{ 0%,100%{ box-shadow:0 0 10px var(--blue-glow); } 50%{ box-shadow:0 0 24px var(--blue-glow); } }

  /* ================= SCREEN SYSTEM ================= */
  .screen{
    position:fixed; inset:0; background:var(--bg);
    display:flex; flex-direction:column;
    opacity:0; pointer-events:none; transform:translateX(12px);
    transition:opacity .32s ease, transform .32s ease;
  }
  .screen.show{ opacity:1; pointer-events:auto; transform:translateX(0); }

  .topbar{ flex-shrink:0; display:flex; align-items:center; gap:12px; padding:18px 18px 14px; }
  .backBtn{
    width:38px; height:38px; border-radius:12px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--blue-light);
    display:flex; align-items:center; justify-content:center; font-size:18px;
  }
  .backBtn:active{ transform:scale(.9); }
  .topbar-title{ font-size:16px; font-weight:700; letter-spacing:1px; text-transform:uppercase; color:var(--text); }

  /* ================= HOME MENU ================= */
  #screen-home .topbar{ padding-top:26px; }
  #screen-home .topbar-title{ font-size:22px; }
  .home-list{ padding:8px 16px; overflow-y:auto; flex:1; }
  .menu-item{
    display:flex; align-items:center; gap:16px;
    padding:18px 14px; border-radius:18px;
    background:var(--panel-2); border:1px solid var(--line);
    margin-bottom:12px;
  }
  .menu-item:active{ transform:scale(.98); background:#151b26; }
  .menu-num{
    font-size:13px; font-weight:800; color:var(--blue-light);
    width:34px; height:34px; border-radius:10px; flex-shrink:0;
    background:rgba(47,125,255,0.12); border:1px solid rgba(111,168,255,0.3);
    display:flex; align-items:center; justify-content:center;
    font-variant-numeric:tabular-nums;
  }
  .menu-icon{ font-size:24px; flex-shrink:0; width:28px; text-align:center; }
  .menu-text{ flex:1; min-width:0; }
  .menu-title{ font-size:16px; font-weight:600; color:var(--text); }
  .menu-sub{ font-size:12px; color:var(--text-dim); margin-top:2px; }
  .menu-chevron{ color:var(--text-dim); font-size:18px; flex-shrink:0; }

  /* ================= CALCULATOR ================= */
  .display{ flex:1 1 auto; display:flex; flex-direction:column; justify-content:flex-end; padding:10px 24px 18px; min-height:100px; }
  .expr{ font-size:20px; color:var(--text-dim); min-height:26px; text-align:right; font-variant-numeric:tabular-nums; word-break:break-all; }
  .result{ font-size:52px; font-weight:300; color:var(--text); text-align:right; line-height:1.1; font-variant-numeric:tabular-nums; word-break:break-all; text-shadow:0 0 20px rgba(47,125,255,0.15); }
  .result.error{ color:var(--danger); font-size:32px; }
  .keys{ flex-shrink:0; display:grid; grid-template-columns:repeat(4,1fr); grid-template-rows:repeat(5,1fr); gap:10px; padding:10px 14px calc(16px + env(safe-area-inset-bottom)); height:52%; }
  .key{ border:none; border-radius:20px; font-size:22px; font-weight:500; display:flex; align-items:center; justify-content:center; background:var(--panel-2); color:var(--text); position:relative; overflow:hidden; transition:transform .08s ease, background .15s ease; }
  .key:active{ transform:scale(.94); }
  .key.fn{ background:#151b26; color:var(--blue-light); font-size:20px; }
  .key.op{ background:linear-gradient(160deg,#173a80,#0f2454); color:#dce9ff; font-size:24px; box-shadow:inset 0 0 0 1px rgba(111,168,255,0.25); }
  .key.op.active{ background:var(--text); color:#0b2a6b; }
  .key.eq{ background:linear-gradient(160deg, var(--blue-light), var(--blue)); color:#fff; font-weight:700; box-shadow:0 0 18px var(--blue-glow); }
  .key.zero{ grid-column:span 2; justify-content:flex-start; padding-left:34px; }
  .ripple{ position:absolute; border-radius:50%; background:rgba(255,255,255,0.25); transform:scale(0); animation:rip .45s ease-out forwards; pointer-events:none; }
  @keyframes rip{ to{ transform:scale(3); opacity:0; } }

  /* ================= TIC TAC TOE ================= */
  .center-col{ display:flex; flex-direction:column; align-items:center; padding:16px 20px; flex:1; overflow-y:auto; }
  .ttt-status{ text-align:center; font-size:14px; color:var(--text-dim); letter-spacing:1px; margin-bottom:6px; text-transform:uppercase; }
  .ttt-board{ display:grid; grid-template-columns:repeat(3,1fr); grid-template-rows:repeat(3,1fr); gap:10px; width:min(320px, 84vw); aspect-ratio:1/1; margin:18px auto; }
  .ttt-cell{ background:var(--panel-2); border:1px solid var(--line); border-radius:16px; display:flex; align-items:center; justify-content:center; font-size:44px; font-weight:700; color:var(--text); }
  .ttt-cell:active{ transform:scale(.96); }
  .ttt-cell.x{ color:var(--blue-light); text-shadow:0 0 14px var(--blue-glow); }
  .ttt-cell.o{ color:var(--text); }
  .ttt-cell.win{ background:rgba(47,125,255,0.18); border-color:var(--blue); }
  .pill-btn{
    margin-top:18px; padding:12px 30px; border-radius:30px; border:1px solid rgba(111,168,255,0.5);
    background:linear-gradient(180deg, rgba(47,125,255,0.18), rgba(47,125,255,0.05));
    color:var(--blue-light); font-size:13px; font-weight:700; letter-spacing:1.5px; text-transform:uppercase;
  }
  .pill-btn:active{ transform:scale(.95); }

  /* ================= TEBAK ANGKA ================= */
  .guess-hint{ font-size:15px; color:var(--text-dim); text-align:center; margin-top:6px; padding:0 20px; }
  .guess-num{ font-size:64px; font-weight:300; color:var(--blue-light); text-shadow:0 0 20px var(--blue-glow); margin:14px 0; }
  .guess-feedback{ font-size:16px; font-weight:700; min-height:22px; letter-spacing:1px; }
  .guess-feedback.up{ color:var(--blue-light); }
  .guess-feedback.down{ color:var(--danger); }
  .guess-feedback.win{ color:var(--green); }
  .guess-input-row{ display:flex; gap:10px; width:100%; max-width:280px; margin-top:20px; }
  .guess-input{ flex:1; background:var(--panel-2); border:1px solid var(--line); border-radius:14px; color:var(--text); font-size:20px; text-align:center; padding:12px 0; -moz-appearance:textfield; }
  .guess-input::-webkit-outer-spin-button, .guess-input::-webkit-inner-spin-button{ -webkit-appearance:none; margin:0; }
  .guess-submit{ padding:0 22px; border-radius:14px; border:none; background:linear-gradient(160deg, var(--blue-light), var(--blue)); color:#fff; font-weight:700; font-size:15px; }
  .guess-submit:active{ transform:scale(.95); }
  .guess-tries{ font-size:12px; color:var(--text-dim); margin-top:14px; letter-spacing:1px; }

  /* ================= CATUR (CHESS) ================= */
  .chess-wrap{ padding-top:8px; }
  .chess-captured{ display:flex; gap:3px; flex-wrap:wrap; justify-content:center; min-height:22px; font-size:16px; color:var(--text-dim); max-width:320px; }
  .chess-board{
    display:grid; grid-template-columns:repeat(8,1fr); grid-template-rows:repeat(8,1fr);
    width:min(336px,88vw); aspect-ratio:1/1; border-radius:14px; overflow:hidden;
    border:1px solid var(--line); margin:10px 0;
  }
  .chess-sq{ display:flex; align-items:center; justify-content:center; font-size:24px; position:relative; }
  .chess-sq.light{ background:#161c28; }
  .chess-sq.dark{ background:#05070a; }
  .chess-sq.selected{ background:rgba(47,125,255,0.38) !important; }
  .chess-sq.check{ background:rgba(255,93,108,0.4) !important; }
  .chess-sq .dot{ width:11px; height:11px; border-radius:50%; background:rgba(111,168,255,0.8); position:absolute; }
  .chess-sq .ring{ position:absolute; inset:4px; border:3px solid rgba(111,168,255,0.8); border-radius:50%; }
  .chess-sq.white-piece{ color:var(--text); text-shadow:0 0 6px rgba(255,255,255,0.3); }
  .chess-sq.black-piece{ color:var(--blue-light); text-shadow:0 0 6px var(--blue-glow); }

  .promo-overlay{
    position:fixed; inset:0; background:rgba(0,0,0,0.72);
    display:flex; align-items:center; justify-content:center; z-index:500;
    opacity:0; pointer-events:none; transition:opacity .25s ease;
  }
  .promo-overlay.show{ opacity:1; pointer-events:auto; }
  .promo-panel{ background:var(--panel-2); border:1px solid var(--line); border-radius:20px; padding:24px; text-align:center; }
  .promo-title{ font-size:12px; letter-spacing:1.5px; color:var(--text-dim); text-transform:uppercase; margin-bottom:14px; }
  .promo-options{ display:flex; gap:12px; }
  .promo-btn{ width:56px; height:56px; border-radius:14px; border:1px solid var(--line); background:var(--panel); font-size:30px; color:var(--blue-light); }
  .promo-btn:active{ transform:scale(.92); }

  /* ================= CACING (SNAKE) ================= */
  .snake-score{ font-size:15px; color:var(--text-dim); letter-spacing:1px; margin-bottom:10px; }
  .snake-score b{ color:var(--blue-light); font-size:20px; }
  .snake-canvas-wrap{ position:relative; width:min(300px,84vw); aspect-ratio:1/1; border-radius:16px; overflow:hidden; border:1px solid var(--line); background:#05070a; }
  #snakeCanvas{ width:100%; height:100%; display:block; }
  .snake-overlay{
    position:absolute; inset:0; background:rgba(0,0,0,0.78);
    display:flex; flex-direction:column; align-items:center; justify-content:center; gap:10px;
    text-align:center; padding:16px;
  }
  .snake-overlay.hide{ display:none; }
  .snake-overlay-title{ font-size:18px; font-weight:700; color:var(--text); }
  .snake-overlay-sub{ font-size:13px; color:var(--text-dim); }
  .snake-dpad{ display:grid; grid-template-columns:56px 56px 56px; grid-template-rows:56px 56px 56px; gap:8px; margin-top:20px; }
  .snake-dbtn{ border:none; border-radius:14px; background:var(--panel-2); color:var(--blue-light); font-size:22px; display:flex; align-items:center; justify-content:center; border:1px solid var(--line); }
  .snake-dbtn:active{ transform:scale(.9); background:#182130; }
  .snake-dbtn.up{ grid-column:2; grid-row:1; }
  .snake-dbtn.left{ grid-column:1; grid-row:2; }
  .snake-dbtn.right{ grid-column:3; grid-row:2; }
  .snake-dbtn.down{ grid-column:2; grid-row:3; }

  /* ================= KAMUS BAHASA INGGRIS ================= */
  .kamus-search{
    margin:0 16px 10px; padding:12px 16px; border-radius:14px;
    background:var(--panel-2); border:1px solid var(--line); color:var(--text);
    font-size:15px;
  }
  .kamus-count{ font-size:11px; color:var(--text-dim); padding:0 20px 8px; letter-spacing:.5px; }
  .kamus-list{ flex:1; overflow-y:auto; padding:0 16px 16px; }
  .kamus-item{ display:flex; justify-content:space-between; align-items:center; padding:14px 14px; border-radius:14px; background:var(--panel-2); border:1px solid var(--line); margin-bottom:8px; }
  .kamus-item:active{ background:#151b26; }
  .kamus-word{ font-size:15px; font-weight:700; color:var(--text); }
  .kamus-tag{ font-size:10px; color:var(--blue-light); text-transform:uppercase; letter-spacing:1px; margin-left:8px; }
  .kamus-meaning{ font-size:13px; color:var(--text-dim); }
  .kamus-empty{ text-align:center; color:var(--text-dim); font-size:13px; padding:30px 0; }

  .kd-overlay{ position:fixed; inset:0; background:rgba(0,0,0,0.75); display:flex; align-items:center; justify-content:center; z-index:500; opacity:0; pointer-events:none; transition:opacity .25s ease; padding:24px; }
  .kd-overlay.show{ opacity:1; pointer-events:auto; }
  .kd-panel{ background:var(--panel-2); border:1px solid var(--line); border-radius:22px; padding:26px; width:100%; max-width:340px; max-height:80vh; overflow-y:auto; }
  .kd-word{ font-size:26px; font-weight:800; color:var(--text); }
  .kd-pos{ font-size:11px; color:var(--blue-light); text-transform:uppercase; letter-spacing:1.5px; margin-top:4px; }
  .kd-meaning{ font-size:16px; color:var(--text-dim); margin-top:12px; }
  .kd-verbs{ margin-top:18px; display:none; }
  .kd-verbs.show{ display:block; }
  .kd-vrow{ display:flex; justify-content:space-between; padding:9px 0; border-bottom:1px solid var(--line); font-size:14px; }
  .kd-vrow span:first-child{ color:var(--text-dim); }
  .kd-vrow span:last-child{ color:var(--text); font-weight:600; }
  .kd-passive{ margin-top:12px; font-size:12px; color:var(--text-dim); line-height:1.6; background:rgba(47,125,255,0.08); border:1px solid rgba(111,168,255,0.2); border-radius:12px; padding:10px 12px; }
  .kd-close{ margin-top:20px; width:100%; padding:12px 0; border-radius:14px; border:none; background:linear-gradient(160deg, var(--blue-light), var(--blue)); color:#fff; font-weight:700; font-size:14px; }
  .kd-close:active{ transform:scale(.97); }

  /* ================= KUIS BAHASA INGGRIS ================= */
  .kuis-stats{ display:flex; gap:18px; font-size:12px; color:var(--text-dim); letter-spacing:.5px; margin-bottom:16px; }
  .kuis-stats b{ color:var(--blue-light); }
  .kuis-prompt{ font-size:19px; font-weight:600; color:var(--text); text-align:center; padding:0 6px; min-height:70px; display:flex; align-items:center; justify-content:center; }
  .kuis-options{ width:100%; max-width:340px; display:flex; flex-direction:column; gap:10px; margin-top:14px; }
  .kuis-opt{
    display:flex; align-items:center; gap:12px; text-align:left;
    padding:14px 16px; border-radius:16px; background:var(--panel-2); border:1px solid var(--line);
    color:var(--text); font-size:15px;
  }
  .kuis-opt:active{ transform:scale(.98); }
  .kuis-opt-label{ width:26px; height:26px; border-radius:8px; background:rgba(47,125,255,0.15); border:1px solid rgba(111,168,255,0.3); color:var(--blue-light); font-size:12px; font-weight:800; display:flex; align-items:center; justify-content:center; flex-shrink:0; }
  .kuis-opt.correct{ background:rgba(61,220,132,0.18); border-color:var(--green); }
  .kuis-opt.correct .kuis-opt-label{ background:var(--green); color:#04180d; border-color:var(--green); }
  .kuis-opt.wrong{ background:rgba(255,93,108,0.18); border-color:var(--danger); }
  .kuis-opt.wrong .kuis-opt-label{ background:var(--danger); color:#2a0509; border-color:var(--danger); }
  #kuisNextBtn{ margin-top:20px; opacity:0; pointer-events:none; transition:opacity .3s ease; }
  #kuisNextBtn.show{ opacity:1; pointer-events:auto; }

  /* ================= UNO FLIP ================= */
  .uno-player-select{ display:flex; gap:12px; }
  .uno-pbtn{
    width:56px; height:56px; border-radius:16px; border:1px solid var(--line);
    background:var(--panel-2); color:var(--text); font-size:20px; font-weight:800;
  }
  .uno-pbtn.active{ background:linear-gradient(160deg, var(--blue-light), var(--blue)); color:#fff; border-color:transparent; box-shadow:0 0 16px var(--blue-glow); }
  .uno-pbtn:active{ transform:scale(.93); }

  .uno-wrap{ position:relative; padding-top:6px; }
  .uno-opponents{ display:flex; gap:8px; flex-wrap:wrap; justify-content:center; margin-bottom:8px; min-height:24px; }
  .uno-opp-chip{ font-size:11px; color:var(--text-dim); background:var(--panel-2); border:1px solid var(--line); border-radius:10px; padding:4px 10px; }
  .uno-side-label{ font-size:11px; letter-spacing:2px; color:var(--blue-light); font-weight:800; margin-bottom:8px; }
  .uno-table{ display:flex; align-items:center; gap:22px; margin:6px 0; }
  .uno-deck-pile{
    width:70px; height:100px; border-radius:14px; background:linear-gradient(160deg,#1a2130,#05070a);
    border:1px solid var(--line); display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-size:26px; color:var(--blue-light); gap:4px;
  }
  .uno-deck-pile span{ font-size:10px; letter-spacing:1px; color:var(--text-dim); text-transform:uppercase; }
  .uno-deck-pile:active{ transform:scale(.94); }
  .uno-card{
    width:74px; height:104px; border-radius:14px; display:flex; align-items:center; justify-content:center;
    font-size:22px; font-weight:800; color:#fff; position:relative; flex-shrink:0;
    box-shadow:0 4px 14px rgba(0,0,0,0.4);
  }
  .uno-card.uno-top{ transform:rotate(3deg); }
  .uno-color-label{ font-size:12px; color:var(--text-dim); margin-top:4px; }
  .uno-color-label b{ color:var(--blue-light); }
  .uno-turn-label{ font-size:14px; font-weight:700; color:var(--text); margin-top:6px; letter-spacing:.5px; }

  .uno-card.c-red, .c-red{ background:linear-gradient(160deg,#ff7078,#a2202c); }
  .uno-card.c-yellow, .c-yellow{ background:linear-gradient(160deg,#ffd54f,#b8860b); color:#2b1d00; }
  .uno-card.c-green, .c-green{ background:linear-gradient(160deg,#4be08f,#0f7a3d); }
  .uno-card.c-blue, .c-blue{ background:linear-gradient(160deg,#6fa8ff,#173a80); }
  .uno-card.c-pink, .c-pink{ background:linear-gradient(160deg,#ff8fd1,#a3226e); }
  .uno-card.c-orange, .c-orange{ background:linear-gradient(160deg,#ffa557,#a4530a); }
  .uno-card.c-teal, .c-teal{ background:linear-gradient(160deg,#4fd8d0,#0d6e68); }
  .uno-card.c-purple, .c-purple{ background:linear-gradient(160deg,#c79bff,#4a1f8a); }
  .uno-card.c-wild, .c-wild{ background:linear-gradient(160deg,#2a2f3a,#05070a); border:2px solid var(--blue-light); }

  .uno-pass-gate{
    position:absolute; inset:0; top:-10px; background:var(--bg);
    display:none; flex-direction:column; align-items:center; justify-content:center; gap:8px; text-align:center;
    z-index:20; padding:20px;
  }
  .uno-pass-gate.show{ display:flex; }
  .uno-pass-title{ font-size:20px; font-weight:800; color:var(--text); }
