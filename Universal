<script>
(function(){
  "use strict";

  /* =========================================================
     BAGIAN 1 — LOADING SCREEN DENGAN PROGRESS ASLI (BUKAN PAJANGAN)
     Progress dihitung dari jumlah tugas nyata yang benar-benar
     dieksekusi: membangun DOM menu utama, tombol kalkulator,
     papan XO, papan catur, dan self-test tiap modul.
  ========================================================= */

  var ringEl = document.getElementById('ringProgress');
  var percentEl = document.getElementById('percentText');
  var barEl = document.getElementById('barInner');
  var statusEl = document.getElementById('statusText');
  var continueBtn = document.getElementById('continueBtn');
  var loadingEl = document.getElementById('loading');

  var CIRC = 339.292;
  var totalSteps = 0;
  var doneSteps = 0;

  function setProgress(){
    var pct = totalSteps ? Math.round((doneSteps/totalSteps)*100) : 0;
    if(pct>100) pct = 100;
    percentEl.textContent = pct + '%';
    barEl.style.width = pct + '%';
    ringEl.style.strokeDashoffset = CIRC - (CIRC * pct/100);
    if(pct>=100){
      statusEl.textContent = 'Selesai dimuat';
      continueBtn.classList.add('show');
    }
  }
  function step(label){ doneSteps++; if(label) statusEl.textContent = label; setProgress(); }
  function nextFrame(){ return new Promise(function(res){ requestAnimationFrame(res); }); }

  /* -------- Navigasi antar layar -------- */
  var screens = {};
  ['home','calculator','ttt','guess','catur','cacing','kamus','kuis','uno-setup','uno'].forEach(function(id){
    screens[id] = document.getElementById('screen-'+id);
  });
  var __prevScreen = 'home';
  function showScreen(id){
    if(__prevScreen==='cacing' && id!=='cacing' && typeof snakeStop==='function') snakeStop();
    Object.keys(screens).forEach(function(k){ screens[k].classList.toggle('show', k===id); });
    if(id==='kamus' && typeof kamusRenderList==='function') kamusRenderList('');
    __prevScreen = id;
  }
  document.querySelectorAll('[data-back]').forEach(function(btn){
    btn.addEventListener('click', function(){ showScreen(btn.dataset.back); });
  });

  /* -------- Data menu utama (flat, tanpa folder/submenu) -------- */
  var homeItems = [
    {icon:'🧮', title:'Kalkulator', sub:'Hitung cepat & akurat', go:'calculator'},
    {icon:'❌', title:'Tic-Tac-Toe (XO)', sub:'2 pemain bergantian', go:'ttt'},
    {icon:'🔢', title:'Tebak Angka', sub:'Tebak 1 sampai 100', go:'guess'},
    {icon:'♟️', title:'Catur', sub:'Catur klasik 2 pemain', go:'catur'},
    {icon:'🐛', title:'Cacing', sub:'Cacing mukbang, makan terus!', go:'cacing'},
    {icon:'📖', title:'Kamus Inggris', sub:'Inggris-Indonesia + V1 V2 V3', go:'kamus'},
    {icon:'🇬🇧', title:'Kuis Bahasa Inggris', sub:'Soal acak A/B/C/D tanpa batas', go:'kuis'},
    {icon:'🃏', title:'UNO Flip', sub:'2-5 pemain, gantian HP', go:'uno-setup'}
  ];

  function buildListSequential(container, items, i){
    if(i >= items.length) return Promise.resolve();
    var it = items[i];
    var row = document.createElement('div');
    row.className = 'menu-item';
    row.innerHTML =
      '<div class="menu-num">' + String(i+1).padStart(2,'0') + '</div>' +
      '<div class="menu-icon">' + it.icon + '</div>' +
      '<div class="menu-text"><div class="menu-title">' + it.title + '</div><div class="menu-sub">' + it.sub + '</div></div>' +
      '<div class="menu-chevron">&#8250;</div>';
    row.addEventListener('click', function(){ showScreen(it.go); });
    container.appendChild(row);
    step('Membangun menu "' + it.title + '"');
    return nextFrame().then(function(){ return buildListSequential(container, items, i+1); });
  }

  /* -------- Definisi tombol kalkulator -------- */
  var keysWrap = document.getElementById('keys');
  var keyDefs = [
    {t:'C', type:'fn', act:'clear'},
    {t:'⌫', type:'fn', act:'back'},
    {t:'%', type:'fn', act:'percent'},
    {t:'÷', type:'op', act:'op', val:'÷'},
    {t:'7', type:'num', act:'num', val:'7'},
    {t:'8', type:'num', act:'num', val:'8'},
    {t:'9', type:'num', act:'num', val:'9'},
    {t:'×', type:'op', act:'op', val:'×'},
    {t:'4', type:'num', act:'num', val:'4'},
    {t:'5', type:'num', act:'num', val:'5'},
    {t:'6', type:'num', act:'num', val:'6'},
    {t:'-', type:'op', act:'op', val:'-'},
    {t:'1', type:'num', act:'num', val:'1'},
    {t:'2', type:'num', act:'num', val:'2'},
    {t:'3', type:'num', act:'num', val:'3'},
    {t:'+', type:'op', act:'op', val:'+'},
    {t:'0', type:'num', act:'num', val:'0', zero:true},
    {t:'.', type:'num', act:'dot'},
    {t:'=', type:'eq', act:'equals'}
  ];

  function buildKeysSequential(i){
    if(i >= keyDefs.length) return Promise.resolve();
    var def = keyDefs[i];
    var btn = document.createElement('button');
    btn.className = 'key ' + (def.type==='fn'?'fn':def.type==='op'?'op':def.type==='eq'?'eq':'') + (def.zero?' zero':'');
    btn.textContent = def.t;
    btn.dataset.act = def.act;
    if(def.val) btn.dataset.val = def.val;
    btn.addEventListener('click', handleKeyPress, {passive:true});
    keysWrap.appendChild(btn);
    step('Membangun tombol "' + def.t + '"');
    return nextFrame().then(function(){ return buildKeysSequential(i+1); });
  }

  /* -------- Mesin evaluasi kalkulator -------- */
  function evaluateExpr(tokens){
    var vals = [tokens[0]];
    var ops = [];
    for(var i=1;i<tokens.length;i+=2){
      var op = tokens[i]; var num = tokens[i+1];
      if(op==='×' || op==='÷'){
        var prev = vals.pop();
        num = op==='×' ? prev*num : (num===0? NaN : prev/num);
        vals.push(num);
      } else { ops.push(op); vals.push(num); }
    }
    var res = vals[0];
    for(var j=0;j<ops.length;j++){ res = ops[j]==='+' ? res+vals[j+1] : res-vals[j+1]; }
    return res;
  }
  window.__calcEvaluate = evaluateExpr;

  /* -------- Bangun papan Tic-Tac-Toe -------- */
  var tttBoardEl = document.getElementById('tttBoard');
  function buildTttSequential(i){
    if(i>=9) return Promise.resolve();
    var cell = document.createElement('div');
    cell.className = 'ttt-cell';
    cell.dataset.idx = i;
    cell.addEventListener('click', tttHandleClick);
    tttBoardEl.appendChild(cell);
    step('Membangun sel papan XO #' + (i+1));
    return nextFrame().then(function(){ return buildTttSequential(i+1); });
  }

  /* -------- Bangun papan Catur (64 petak, kerja nyata) -------- */
  var chessBoardEl = document.getElementById('chessBoard');
  function buildChessSequential(i){
    if(i>=64) return Promise.resolve();
    var visRow = Math.floor(i/8), visCol = i%8;
    var arrR = 7-visRow, arrC = visCol;
    var sq = document.createElement('div');
    sq.className = 'chess-sq ' + (((arrR+arrC)%2===0) ? 'dark' : 'light');
    sq.dataset.r = arrR; sq.dataset.c = arrC;
    sq.addEventListener('click', function(){ chessSelectSquare(arrR, arrC); });
    chessBoardEl.appendChild(sq);
    step('Membangun petak catur ' + (i+1) + '/64');
    return nextFrame().then(function(){ return buildChessSequential(i+1); });
  }

  /* -------- Tahapan sistem tambahan -------- */
  var SYSTEM_STEPS = ['font','engine1','engine2','engine3','guess-init','chess-init','snake-init','dict-init','quiz-init','uno-init','bind','finalize'];

  totalSteps = homeItems.length + keyDefs.length + 9 + 64 + SYSTEM_STEPS.length;

  function runSystemSteps(i){
    if(i>=SYSTEM_STEPS.length){ finalizeLoad(); return; }
    var key = SYSTEM_STEPS[i];
    var work;
    if(key==='font'){
      statusEl.textContent = 'Memuat font tampilan';
      work = (document.fonts && document.fonts.ready) ? document.fonts.ready : Promise.resolve();
    } else if(key==='engine1'){
      statusEl.textContent = 'Menguji mesin: penjumlahan';
      work = Promise.resolve(evaluateExpr([2,'+',3]) === 5);
    } else if(key==='engine2'){
      statusEl.textContent = 'Menguji mesin: perkalian & presedensi';
      work = Promise.resolve(evaluateExpr([2,'+',3,'×',4]) === 14);
    } else if(key==='engine3'){
      statusEl.textContent = 'Menguji mesin: pembagian';
      work = Promise.resolve(evaluateExpr([10,'÷',2,'-',1]) === 4);
    } else if(key==='guess-init'){
      statusEl.textContent = 'Menyiapkan game tebak angka';
      work = Promise.resolve(initGuessGame());
    } else if(key==='chess-init'){
      statusEl.textContent = 'Menyiapkan papan catur';
      work = Promise.resolve(initChess());
    } else if(key==='snake-init'){
      statusEl.textContent = 'Menyiapkan game Cacing';
      work = Promise.resolve(initSnake());
    } else if(key==='dict-init'){
      statusEl.textContent = 'Memuat kamus (' + (VERB_DICT.length+WORD_DICT.length) + ' kata)';
      work = Promise.resolve(initKamus());
    } else if(key==='quiz-init'){
      statusEl.textContent = 'Menyiapkan kuis Bahasa Inggris';
      work = Promise.resolve(initQuiz());
    } else if(key==='uno-init'){
      statusEl.textContent = 'Menyiapkan UNO Flip';
      work = Promise.resolve(initUno());
    } else if(key==='bind'){
      statusEl.textContent = 'Menyiapkan input pengguna';
      work = Promise.resolve(bindKeyboard());
    } else {
      statusEl.textContent = 'Finalisasi aplikasi';
      work = Promise.resolve();
    }
    Promise.resolve(work).then(function(){ step(); return nextFrame(); })
      .then(function(){ runSystemSteps(i+1); });
  }

  function finalizeLoad(){ doneSteps = totalSteps; setProgress(); }

  continueBtn.addEventListener('click', function(){
    if(!continueBtn.classList.contains('show')) return;
    loadingEl.classList.add('hide');
    showScreen('home');
    setTimeout(function(){ loadingEl.style.display='none'; }, 550);
  });

  /* =========================================================
     BAGIAN 2 — LOGIKA KALKULATOR
  ========================================================= */
  var exprEl = document.getElementById('exprEl');
  var resultEl = document.getElementById('resultEl');
  var calcState = { tokens:[], current:'0', justEvaluated:false };

  function formatNum(n){
    if(!isFinite(n)) return 'Error';
    var r = Math.round(n * 1e10) / 1e10;
    var s = r.toString();
    if(s.length > 14) s = r.toPrecision(10).toString();
    return s;
  }
  function renderExpr(){ exprEl.textContent = calcState.tokens.join(' ') || '\u00A0'; }
  function renderCurrent(isError){
    resultEl.textContent = calcState.current;
    resultEl.classList.toggle('error', !!isError);
  }
  function clearAll(){ calcState.tokens=[]; calcState.current='0'; calcState.justEvaluated=false; renderExpr(); renderCurrent(false); }
  function backspace(){
    if(calcState.justEvaluated) return clearAll();
    calcState.current = calcState.current.length>1 ? calcState.current.slice(0,-1) : '0';
    renderCurrent(false);
  }
  function inputNum(d){
    if(calcState.justEvaluated){ calcState.tokens=[]; calcState.current='0'; calcState.justEvaluated=false; }
    calcState.current = calcState.current==='0' ? d : calcState.current+d;
    renderCurrent(false);
  }
  function inputDot(){
    if(calcState.justEvaluated){ calcState.tokens=[]; calcState.current='0'; calcState.justEvaluated=false; }
    if(calcState.current.indexOf('.')===-1){ calcState.current += '.'; renderCurrent(false); }
  }
  function inputOp(op){
    if(calcState.justEvaluated){ calcState.tokens=[calcState.current]; calcState.justEvaluated=false; }
    else{ calcState.tokens.push(calcState.current); }
    calcState.tokens.push(op); calcState.current='0';
    renderExpr(); renderCurrent(false);
    document.querySelectorAll('.key.op').forEach(function(b){ b.classList.toggle('active', b.dataset.val===op); });
  }
  function inputPercent(){
    var n = parseFloat(calcState.current) || 0;
    calcState.current = formatNum(n/100);
    renderCurrent(false);
  }
  function doEquals(){
    document.querySelectorAll('.key.op').forEach(function(b){ b.classList.remove('active'); });
    if(calcState.tokens.length===0) return;
    var full = calcState.tokens.concat([calcState.current]);
    var expr = [];
    for(var i=0;i<full.length;i++){ expr.push(i%2===0 ? parseFloat(full[i]) : full[i]); }
    var result;
    try{ result = window.__calcEvaluate(expr); } catch(e){ result = NaN; }
    exprEl.textContent = full.join(' ') + ' =';
    if(!isFinite(result)){ calcState.current='Error'; renderCurrent(true); }
    else { calcState.current = formatNum(result); renderCurrent(false); }
    calcState.tokens=[]; calcState.justEvaluated=true;
  }
  function ripple(e, btn){
    var circle = document.createElement('span');
    circle.className='ripple';
    var rect = btn.getBoundingClientRect();
    var size = Math.max(rect.width, rect.height);
    circle.style.width = circle.style.height = size+'px';
    var x = (e.touches? e.touches[0].clientX : e.clientX) - rect.left - size/2;
    var y = (e.touches? e.touches[0].clientY : e.clientY) - rect.top - size/2;
    circle.style.left = x+'px'; circle.style.top = y+'px';
    btn.appendChild(circle);
    setTimeout(function(){ circle.remove(); }, 450);
  }
  function handleKeyPress(e){
    var btn = e.currentTarget; ripple(e, btn);
    var act = btn.dataset.act, val = btn.dataset.val;
    if(act==='num') inputNum(val);
    else if(act==='dot') inputDot();
    else if(act==='op') inputOp(val);
    else if(act==='percent') inputPercent();
    else if(act==='back') backspace();
    else if(act==='clear') clearAll();
    else if(act==='equals') doEquals();
  }

